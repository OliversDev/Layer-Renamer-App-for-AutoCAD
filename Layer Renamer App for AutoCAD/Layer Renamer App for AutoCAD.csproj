<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- AutoCAD 2026 uses .NET 8; AutoCAD 2027 uses .NET 10. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <AutoCAD2026Dir>C:\Program Files\Autodesk\AutoCAD 2026</AutoCAD2026Dir>
    <AutoCAD2027Dir>C:\Program Files\Autodesk\AutoCAD 2027</AutoCAD2027Dir>

    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>Layer_Renamer_App_for_AutoCAD</RootNamespace>
    <AssemblyName>Layer Renamer App for AutoCAD</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">pdbonly</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <OutputPath>bin\$(Configuration)\AutoCAD2026\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\AutoCAD2026\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputPath>bin\$(Configuration)\AutoCAD2027\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\AutoCAD2027\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCAD2026Dir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCAD2026Dir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCAD2026Dir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCAD2027Dir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCAD2027Dir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCAD2027Dir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Commands.cs" />
    <Compile Include="LayerRenamerTheme.cs" />
    <Compile Include="MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Include="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <Compile Include="ThemedMessageBox.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>true</AutoGen><DesignTime>true</DesignTime><DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MainForm.resx"><DependentUpon>MainForm.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator><LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="LayerRenamerIcon.ico" LogicalName="AutoCADLayerRenamer.LayerRenamerIcon.ico" />
  </ItemGroup>
</Project>
